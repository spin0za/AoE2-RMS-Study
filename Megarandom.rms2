  set_place_for_every_player
  
	if MEGAORDER_MULTITUDEOFNOMADVILLSA
	
		if LUDIKRIS_MAP
  temp_min_distance_group_placement  35
		else
  temp_min_distance_group_placement  15
		endif
		
	elseif MEGAORDER_MULTITUDEOFNOMADVILLSB
	
			if LUDIKRIS_MAP
  temp_min_distance_group_placement  25
		else
  temp_min_distance_group_placement  8
		endif
	
	else
	
		if LUDIKRIS_MAP
  temp_min_distance_group_placement  65
		else
  temp_min_distance_group_placement  35
		endif
		
	endif
	

  avoid_forest_zone 2
  min_distance_group_placement 2

	if GNR_NOMADIC_FORCE_LAYA
		terrain_to_place_on LAYER_A 
	elseif GNR_NOMADIC_FORCE_LAYB
		terrain_to_place_on LAYER_B
