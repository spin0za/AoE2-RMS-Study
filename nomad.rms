<PLAYER_SETUP>
	#include_drs includes/preliminaries.inc

	if EMPIRE_WARS_MODE
		random_placement
	else
		direct_placement
	endif

	if THEME_AMERICAS_DESERT
		effect_amount GAIA_UPGRADE_UNIT TREE_DRAGON TREE_DEAD 0
	elseif THEME_EASTERN
		effect_amount GAIA_UPGRADE_UNIT TREE_DRAGON TREE_DEAD 0
	elseif THEME_ASIAN_TEMPERATE
		effect_amount GAIA_UPGRADE_UNIT TREE_AUTUMN TREE_MAPLE_AUTUMN 0
	endif

	if CONFINED_SETUP
		#const CONFINED_INCREASE 1.2
	else
		#const CONFINED_INCREASE 1
	endif

<LAND_GENERATION>
	base_terrain WATER_SHALLOW
	enable_waves 1

	#include_drs includes/market_lands.inc

	create_land
	{
		terrain_type COAST_TERRAIN
		land_percent 0
		base_size 0
		land_position 50 50
		land_id 420
	}

	start_random
		percent_chance 50 #define MIDDLE_POND
	end_random

	start_random
		/* Northern */
		percent_chance 6 #define LAND_LOCKED_A
		percent_chance 6 #define LAND_LOCKED_B

		/* Western */
		percent_chance 6 #define LAND_LOCKED_C
		percent_chance 6 #define LAND_LOCKED_D

		/* Eastern */
		percent_chance 6 #define LAND_LOCKED_E
		percent_chance 6 #define LAND_LOCKED_F

		/* Southern */
		percent_chance 6 #define LAND_LOCKED_G
		percent_chance 6 #define LAND_LOCKED_H
	end_random

	if LAND_LOCKED_A
		#define NORTH_WATER_SMALL
	elseif LAND_LOCKED_B
		#define NORTH_WATER_SMALL
	else
		start_random
			percent_chance 25 #define NORTH_WATER_SMALL
			percent_chance 35 #define NORTH_WATER_MEDIUM
			percent_chance 40 #define NORTH_WATER_LARGE
		end_random
	endif

