<LAND_GENERATION>
	base_terrain WATER_SHALLOW
	enable_waves 0

	#include_drs includes/market_lands.inc

	create_land
	{
		terrain_type SPAWN_TERRAIN
		number_of_tiles 0
		base_size 0
		land_position 50 50
		land_id 420
	}

	create_player_lands
	{
		terrain_type SPAWN_TERRAIN
		land_percent 100
		base_size 12
		clumping_factor 15
		other_zone_avoidance_distance 4
		circle_radius 36 8
	}

<ELEVATION_GENERATION>
	create_elevation 5
	{
		enable_balanced_elevation
		base_terrain SPAWN_TERRAIN

		#const SPAWN_ELEVATION_TILES 768
		#const SPAWN_ELEVATION_CLUMPS 48

		number_of_tiles (SPAWN_ELEVATION_TILES * MAPSCALE_AREA)
		number_of_clumps (SPAWN_ELEVATION_CLUMPS * MAPSCALE_AREA)
	}

