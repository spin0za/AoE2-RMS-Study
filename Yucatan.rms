
/* Yucatan 2021 */

/* Note: random_map.def is automatically included in every rms script */
/* updated for ANTIQUITY_MODE November 2023 */

<PLAYER_SETUP>
  random_placement 
	ai_info_map_type YUCATAN 0 0 0

<LAND_GENERATION>


  #define TROPICAL_MAP
enable_waves 0 

base_terrain DLC_WATER5

create_player_lands 
{            
  terrain_type                     GRASS3
  land_percent                     97
  base_size                        13
  other_zone_avoidance_distance    4 /* 6 originally */
}

/* ****************************************************** */
<TERRAIN_GENERATION>
if ANTIQUITY_MODE
create_terrain MEDITERRANEAN_FOREST
else
create_terrain JUNGLE
endif
{
  base_terrain                   GRASS3
  spacing_to_other_terrain_types 4
  land_percent                   22
  number_of_clumps               38
  set_avoid_player_start_areas     
}

if ANTIQUITY_MODE
create_terrain MEDITERRANEAN_FOREST
else
create_terrain JUNGLE
endif
{
  base_terrain                   GRASS3
  spacing_to_other_terrain_types 5
  land_percent                   1
  number_of_clumps               20
  set_avoid_player_start_areas     
}

